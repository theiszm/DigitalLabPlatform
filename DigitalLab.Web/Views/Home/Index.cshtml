@model List<DigitalLab.Web.Models.Reading>

<div class="container mt-4">

    <h2 class="mb-4">Digital Lab Dashboard</h2>

    <div class="row">

        <div class="mb-3">
            <label><strong>Select Instrument:</strong></label>
            <select id="instrumentSelect" class="form-select">
                @foreach (var inst in ViewBag.Instruments)
                {
                    <option value="@inst.Id" selected="@(inst.Id == ViewBag.SelectedInstrumentId)">
                        @inst.Name
                    </option>
                }
            </select>
        </div>

        <div class="mb-3">
            <strong>Instrument:</strong>
            @(Model.FirstOrDefault()?.Instrument?.Name ?? "N/A")
        </div>
        
        <!-- Chart -->
        <div class="col-md-8">
            <div class="card p-3 shadow-sm">
                <canvas id="chart"></canvas>
            </div>
        </div>

        <!-- Stats -->
        <div class="col-md-4">
            <div class="card p-3 shadow-sm mb-3">
                <h5>Latest Value</h5>
                <p id="latest"></p>
            </div>

            <div class="card p-3 shadow-sm">
                <h5>Total Readings</h5>
                <p>@ViewBag.TotalCount</p>
            </div>
        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    let chart;
    let lastTimestamp = null;

    function createChart() {
    const ctx = document.getElementById('chart').getContext('2d');

    chart = new Chart(ctx, {
    type: 'line',
    data: {
    labels: [],
    datasets: [{
    label: 'Instrument Data',
    data: [],
    borderWidth: 2
    }]
    },
    options: {
    responsive: true,
    scales: {
    y: { min: 0, max: 100 }
    }
    }
    });
    }

    // initial load: fill with latest 50
    async function loadInitial() {
        const instrumentId = document.getElementById("instrumentSelect")?.value || 1;

        const res = await fetch(`/api/readings/latest?instrumentId=${instrumentId}`);
        const data = await res.json();

        const labels = data.map(x => new Date(x.timestamp).toLocaleTimeString());
        const values = data.map(x => x.value);

        chart.data.labels = labels;
        chart.data.datasets[0].data = values;
        chart.update();

        if (data.length > 0) {
            lastTimestamp = data[data.length - 1].timestamp;
        }
    }

    // update: only append NEW points
    async function updateChart() {
        const instrumentId = document.getElementById("instrumentSelect")?.value || 1;

        const res = await fetch(`/api/readings/latest?instrumentId=${instrumentId}`);
        const data = await res.json();

        if (!data || data.length === 0) return;

            const latest = data[data.length - 1];

        if (lastTimestamp !== latest.timestamp) {
            const label = new Date(latest.timestamp).toLocaleTimeString();
            const value = latest.value;

            chart.data.labels.push(label);
            chart.data.datasets[0].data.push(value);

            if (chart.data.labels.length > 50) {
                chart.data.labels.shift();
                chart.data.datasets[0].data.shift();
            }

            chart.update();
            lastTimestamp = latest.timestamp;
        }
    }

    window.onload = function () {
    createChart();
    loadInitial();

    setInterval(updateChart, 2000);

    document.getElementById("instrumentSelect").addEventListener("change", function () {
        location.reload();
    });
};
</script>